{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickLauncher",
  "mainBinaryName": "Quick Launcher",
  "version": "0.2.2",
  "identifier": "com.quicklauncher.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quick Launcher",
        "label": "main",
        "width": 800,
        "height": 600,
        "dragDropEnabled": false,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      },
      {
        "title": "Search",
        "label": "search",
        "width": 600,
        "height": 45,
        "dragDropEnabled": false,
        "center": true,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "url": "/#/search",
        "backgroundColor": null,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "contentProtected": false
      },
      {
        "title": "Setting",
        "label": "setting",
        "width": 600,
        "height": 500,
        "dragDropEnabled": false,
        "url": "/#/setting",
        "visible": false,
        "center": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": false
      },
      {
        "title": "Operation Launch",
        "label": "operLaunch",
        "width": 600,
        "height": 400,
        "url": "/#/operLaunch",
        "visible": false,
        "center": false,
        "dragDropEnabled": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": false
      },
      {
        "title": "Operation Category",
        "label": "operCategory",
        "width": 600,
        "height": 350,
        "url": "/#/operCategory",
        "visible": false,
        "center": false,
        "dragDropEnabled": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": false
      },
      {
        "title": "Clipboard Toast",
        "label": "clipboardToast",
        "width": 320,
        "height": 130,
        "center": false,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "url": "/#/clipboardToast",
        "backgroundColor": null,
        "shadow": true,
        "skipTaskbar": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "contentProtected": false,
        "x": 1550,
        "y": 835
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["tray"],
    "windows": {
      "allowDowngrades": true,
      "certificateThumbprint": null,
      "digestAlgorithm": null,
      "nsis": null,
      "signCommand": null,
      "timestampUrl": null,
      "tsp": false,
      "webviewInstallMode": {
        "silent": true,
        "type": "downloadBootstrapper"
      },
      "wix": null
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhENDBBNDk4NzY1QjA2NApSV1Jrc0dXSFNRclVDQVV1MVFDUHVFb2VyN3VEMDNCM1ZlRFA5VmZqWmhQTzlkUDhFcGlXT1hNdAo=",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": ["https://github.com/Peng1203/QuickLauncher/releases/latest/download/latest.json"]
    }
  }
}
